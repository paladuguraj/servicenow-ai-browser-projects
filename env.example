# ServiceNow credentials (copy to .env and fill in)
#   cp env.example .env
#
# To target another instance, create a second file and point ENV_FILE at it:
#   cp env.example .env.other
#   ENV_FILE=.env.other npm run preflight:csat
#
# The deploying account needs the admin role and must be able to use the REST
# API. Interactive UI/portal testing additionally requires a non-integration
# user, since integration users are blocked from the UI.
SN_INSTANCE_URL=https://your-instance.service-now.com
SN_USERNAME=admin
SN_PASSWORD=your-password
